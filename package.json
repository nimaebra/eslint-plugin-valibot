{
  "name": "eslint-plugin-valibot",
  "version": "1.4.2",
  "description": "ESLint rules for safer, more maintainable Valibot usage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimaebra/eslint-plugin-valibot.git"
  },
  "homepage": "https://github.com/nimaebra/eslint-plugin-valibot#readme",
  "bugs": {
    "url": "https://github.com/nimaebra/eslint-plugin-valibot/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "valibot",
    "schema",
    "validation",
    "typescript"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "changeset": "changeset",
    "clean": "rimraf dist coverage",
    "configs:check": "tsx scripts/check-configs.ts",
    "create:rule": "tsx scripts/generate-rule.ts",
    "docs:build": "eslint-doc-generator . && tsx scripts/build-configs-doc.ts",
    "docs:check": "eslint-doc-generator --check . && tsx scripts/check-docs.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "pack:dry-run": "pnpm pack --dry-run",
    "prepublishOnly": "pnpm security:audit && pnpm check",
    "release:publish": "changeset publish",
    "security:audit": "pnpm audit --audit-level=moderate",
    "smoke:pack": "tsx scripts/smoke-pack.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests/rules tests/configs tests/utils",
    "test:coverage": "vitest run tests/rules tests/configs tests/utils --coverage",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm knip && pnpm test && pnpm build && pnpm test:integration && pnpm docs:check && pnpm configs:check",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.72.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "valibot": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "valibot": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-doc-generator": "^3.7.1",
    "globals": "^17.13.0",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "valibot": "^1.5.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
