{
  "name": "eslint-plugin-valibot",
  "version": "1.5.1",
  "description": "ESLint rules for safer, more maintainable Valibot usage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimaebra/eslint-plugin-valibot.git"
  },
  "homepage": "https://github.com/nimaebra/eslint-plugin-valibot#readme",
  "bugs": {
    "url": "https://github.com/nimaebra/eslint-plugin-valibot/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "valibot",
    "schema",
    "validation",
    "typescript"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.28.13+sha512.d5caa9cdcd6067ac2902f9f44daa00b1288a73babf1e98f4f375b3a7583b1894b4d49f7527da8f5e1530198bb10e03adba321a1f015429dc2946ce8a7a9a8c65",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "benchmark:lint": "tsx scripts/benchmark-lint.ts",
    "branch:check": "validate-branch-name",
    "changeset": "changeset",
    "clean": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await Promise.all(['dist', 'coverage'].map(path => rm(path, { recursive: true, force: true })))\"",
    "configs:check": "tsx scripts/check-configs.ts",
    "commitlint": "commitlint",
    "conventions:check": "pnpm branch:check && pnpm commitlint --from origin/main --to HEAD --verbose",
    "create:rule": "tsx scripts/generate-rule.ts",
    "docs:build": "eslint-doc-generator . && tsx scripts/build-configs-doc.ts",
    "docs:check": "eslint-doc-generator --check . && tsx scripts/check-docs.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "hooks:install": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "pack:dry-run": "pnpm pack --dry-run",
    "prepublishOnly": "pnpm security:audit && pnpm check",
    "release:publish": "changeset publish",
    "security:audit": "pnpm audit --audit-level=moderate",
    "smoke:pack": "tsx scripts/smoke-pack.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests/rules tests/configs tests/utils",
    "test:coverage": "vitest run tests/rules tests/configs tests/utils --coverage",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm knip && pnpm test && pnpm build && pnpm test:integration && pnpm docs:check && pnpm configs:check",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.73.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "valibot": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "valibot": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-doc-generator": "^3.7.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "valibot": "^1.5.0",
    "validate-branch-name": "^1.3.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
